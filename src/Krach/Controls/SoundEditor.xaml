<UserControl x:Class="Krach.Controls.SoundEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" KeyDown="NameBox_KeyDown" LostKeyboardFocus="NameBox_LostKeyboardFocus"/>

        <Grid>
            <TextBlock Text="Lautstärke dieses Sounds" Style="{StaticResource Label}"/>
            <TextBlock x:Name="VolText" Text="100 %" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
        </Grid>
        <Slider x:Name="VolSlider" Minimum="0" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" ValueChanged="VolSlider_ValueChanged"/>

        <TextBlock Text="Beim Tastendruck" Style="{StaticResource Label}"/>
        <ComboBox x:Name="ModeBox" SelectionChanged="ModeBox_SelectionChanged"/>

        <CheckBox x:Name="LoopBox" Style="{StaticResource Switch}" Content="Endlosschleife" Margin="0,14,0,0"
                  Checked="LoopBox_Changed" Unchecked="LoopBox_Changed"/>

        <TextBlock Text="Farbe" Style="{StaticResource Label}"/>
        <WrapPanel x:Name="ColorPanel"/>

        <TextBlock x:Name="FileText" Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
