<Window x:Class="Krach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Krach.Controls"
        Title="Krach Soundboard" Width="1240" Height="820" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="Assets/krach.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Seitenleiste ============ -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="19" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Krach" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Soundboard" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10" CornerRadius="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusLed" Width="10" Height="10" Fill="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusTitle" Text="Kein Makropad" Margin="9,0,0,0" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="EmergencyButton" Style="{StaticResource DangerButton}" Click="EmergencyButton_Click" Padding="12,10"
                            ToolTip="Schaltet sofort alle gerätespezifischen Eingabe-Hooks ab (Strg + Alt + F12)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}"/>
                            <TextBlock x:Name="EmergencyText" Text="Notaus" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Jederzeit: Strg + Alt + F12" Style="{StaticResource Hint}" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavBoard" Style="{StaticResource NavButton}" Tag="&#xE80A;" Content="Soundboard" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="Bibliothek" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPad" Style="{StaticResource NavButton}" Tag="&#xE765;" Content="Makropad" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAudio" Style="{StaticResource NavButton}" Tag="&#xE720;" Content="Audio &amp; Discord" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Einstellungen" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Inhalt ============ -->
        <Grid Grid.Column="1" Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Notaus-Banner -->
            <Border x:Name="EmergencyBanner" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Eingabe wieder aktivieren" Click="EmergencyButton_Click"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FFB3BB"
                               Text="Notaus aktiv: Das Makropad wird gerade komplett ignoriert und keine Taste wird blockiert."/>
                </DockPanel>
            </Border>

            <!-- Hinweis-Leiste -->
            <Border x:Name="MessageBar" Grid.Row="1" Background="{StaticResource WarnSoftBrush}" BorderBrush="#6B5620" BorderThickness="1"
                    CornerRadius="12" Padding="16,10" Margin="0,0,0,14" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="&#xE711;" FontFamily="{StaticResource IconFont}"
                            Click="MessageClose_Click" Padding="8,4"/>
                    <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FFE3A3"/>
                </DockPanel>
            </Border>

            <!-- ===== Seite: Soundboard ===== -->
            <Grid x:Name="PageBoard" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="PageNameBox" Width="150" ToolTip="Seitenname – Enter zum Übernehmen"
                                 KeyDown="PageNameBox_KeyDown" LostKeyboardFocus="PageNameBox_LostKeyboardFocus"/>
                        <Button Content="+ Seite" Margin="8,0,0,0" Click="AddPage_Click"/>
                        <Button Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="DeletePage_Click" ToolTip="Seite löschen">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Soundboard" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    <StackPanel x:Name="PagesPanel" Orientation="Horizontal" Margin="22,0,12,0" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,18,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="SetupHint" Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,18,12"
                                Visibility="Collapsed">
                            <DockPanel>
                                <Button x:Name="SetupHintButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Jetzt einrichten"
                                        Click="SetupHint_Click"/>
                                <TextBlock x:Name="SetupHintText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </DockPanel>
                        </Border>
                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,0,18,0">
                            <Border CornerRadius="28" Padding="26" Background="#12151B" BorderBrush="#262B37" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.45" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <UniformGrid x:Name="KnobGrid" Columns="3" Rows="1" Margin="0,0,0,16"/>
                                    <UniformGrid x:Name="SlotGrid" Columns="3" Rows="3" Width="510" Height="440"/>
                                </StackPanel>
                            </Border>
                        </Viewbox>
                    </Grid>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock x:Name="SlotTitle" Text="Taste 1" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="SlotKeyText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="SlotPlayButton" Style="{StaticResource AccentButton}" Click="SlotPlay_Click" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}"/>
                                            <TextBlock Text="Abspielen" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Taste anlernen" Click="SlotLearn_Click" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Leeren" Click="SlotClear_Click" Margin="0,0,0,8"/>
                                </WrapPanel>

                                <TextBlock Text="Sound auf dieser Taste" Style="{StaticResource Label}" Margin="0,8,0,6"/>
                                <ComboBox x:Name="SlotSoundBox" SelectionChanged="SlotSoundBox_SelectionChanged"/>

                                <c:SoundEditor x:Name="SlotEditor" Margin="0,4,0,0"/>

                                <TextBlock Text="Bibliothek – auf eine Taste ziehen oder doppelklicken" Style="{StaticResource Label}" Margin="0,18,0,6"/>
                                <ListBox x:Name="MiniLibrary" Height="200" PreviewMouseLeftButtonDown="Library_PreviewMouseDown"
                                         PreviewMouseMove="Library_PreviewMouseMove" MouseDoubleClick="MiniLibrary_DoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Wiedergabeleiste -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource DangerButton}" Click="StopAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}"/>
                                <TextBlock Text="Alle stoppen" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Margin="8,0,0,0" Click="PauseAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PauseIcon" Text="&#xE769;" Style="{StaticResource Icon}"/>
                                <TextBlock x:Name="PauseText" Text="Pause" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Grid Grid.Column="2" Margin="22,0,22,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="54"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" Foreground="{StaticResource SubBrush}" Margin="0,0,10,0"/>
                            <Slider x:Name="BoardVolume" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="BoardVolume_ValueChanged"
                                    ToolTip="Soundboard-Lautstärke (für alle Sounds)"/>
                            <TextBlock x:Name="BoardVolumeText" Grid.Column="2" Text="80 %" HorizontalAlignment="Right" Foreground="{StaticResource SubBrush}"/>
                            <Border x:Name="BoardMeterTrack" Grid.Row="1" Grid.Column="1" Style="{StaticResource MeterTrack}" Margin="0,4,0,0">
                                <Border x:Name="BoardMeterFill" Style="{StaticResource MeterFill}"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="PlayingText" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}" Text="Bereit"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Seite: Bibliothek ===== -->
            <Grid x:Name="PageLibrary" Grid.Row="2" Visibility="Collapsed" AllowDrop="True" Drop="Library_Drop" DragOver="Files_DragOver"
                  Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Click="AddSounds_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/>
                                <TextBlock Text="Sounds hinzufügen" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Soundordner öffnen" Margin="8,0,0,0" Click="OpenSoundsFolder_Click"/>
                    </StackPanel>
                    <TextBlock Text="Bibliothek" Style="{StaticResource H1}"/>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,18,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchPlaceholder" Text="Suchen …" IsHitTestVisible="False" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource SubBrush}"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="LibraryCount" Style="{StaticResource Hint}" Margin="4,10,0,0"/>
                            <Grid>
                                <ListBox x:Name="LibraryList" SelectionChanged="LibraryList_SelectionChanged" MouseDoubleClick="LibraryList_DoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="9" Background="{Binding Color}">
                                                    <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ModeText}" FontSize="11" Foreground="{StaticResource SubBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE8EE;" FontFamily="{StaticResource IconFont}"
                                                           Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"
                                                           ToolTip="Endlosschleife">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Loop}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="LibraryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                                               Foreground="{StaticResource SubBrush}"/>
                                    <TextBlock Text="MP3-, WAV- oder OGG-Dateien hierher ziehen" Margin="0,12,0,0" HorizontalAlignment="Center"
                                               Foreground="{StaticResource SubBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Sound bearbeiten" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="LibUsage" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                                <c:SoundEditor x:Name="LibEditor"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="LibPlayButton" Style="{StaticResource AccentButton}" Click="LibPlay_Click" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}"/>
                                            <TextBlock Text="Abspielen / Stoppen" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LibAssignButton" Content="Auf ausgewählte Taste legen" Click="LibAssign_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="LibDeleteButton" Style="{StaticResource DangerButton}" Click="LibDelete_Click" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                                            <TextBlock Text="Löschen" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Seite: Makropad ===== -->
            <ScrollViewer x:Name="PagePad" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Makropad" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,18" FontSize="13.5"
                               Text="Nur das hier ausgewählte Gerät löst Sounds aus. Deine normale Tastatur wird nie benutzt und nie blockiert."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="DetectButton" Click="Detect_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE765;" Style="{StaticResource Icon}"/>
                                            <TextBlock x:Name="DetectText" Text="Per Tastendruck erkennen" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="RefreshDevices_Click" ToolTip="Liste aktualisieren">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Angeschlossene Tastaturen" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox x:Name="DeviceList" Margin="0,14,0,0" MaxHeight="260" SelectionChanged="DeviceList_SelectionChanged"
                                     MouseDoubleClick="DeviceList_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center"
                                                       Foreground="{StaticResource SubBrush}"/>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource SubBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="10" Padding="10,3" Background="{StaticResource AccentSoftBrush}"
                                                    VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                                                <TextBlock Text="{Binding Badge}" FontSize="11.5"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="DeviceDetails" Style="{StaticResource Hint}" FontSize="11" Margin="4,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="UseDeviceButton" Style="{StaticResource AccentButton}" Content="Dieses Gerät als Makropad verwenden"
                                        Click="UseDevice_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="Auswahl aufheben" Margin="8,0,0,0" Click="ClearDevice_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Originaltasten des Makropads blockieren" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Ohne Blockieren erkennt Krach das Makropad trotzdem – aber die Taste (z. B. „C“) kommt zusätzlich im Spiel an. Mit dem installierten Interception-Treiber wird nur das Makropad abgefangen."/>
                            <CheckBox x:Name="BlockBox" Style="{StaticResource Switch}" Content="Makropad-Tasten blockieren (Interception)"
                                      Checked="BlockBox_Changed" Unchecked="BlockBox_Changed" Margin="0,14,0,0"/>
                            <Border x:Name="IcpStatusBorder" CornerRadius="10" Padding="14,10" Margin="0,14,0,0" Background="{StaticResource Card2Brush}">
                                <TextBlock x:Name="IcpStatusText" TextWrapping="Wrap" FontSize="13"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="AdminButton" Content="Als Administrator neu starten" Click="Admin_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                                <Button x:Name="RetryIcpButton" Content="Erneut versuchen" Click="RetryIcp_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Live-Test" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,12" Text="Drücke eine Taste – hier siehst du, von welchem Gerät sie kommt und ob sie einen Sound auslöst."/>
                            <Border CornerRadius="12" Background="{StaticResource Card2Brush}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="70" Height="58" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                        <TextBlock x:Name="LiveKey" Text="–" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveDevice" Text="Noch keine Taste gedrückt" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LiveResult" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="LearnAllButton" Style="{StaticResource AccentButton}" Content="Alle Tasten &amp; Regler anlernen"
                                        Click="LearnAll_Click"/>
                                <TextBlock Text="Tasten anlernen" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Krach fragt nacheinander jede Taste und jede Drehrichtung ab. Drücke einfach, was angezeigt wird. Was dein Makropad sendet (C, F, H …), ist egal."/>
                            <Border x:Name="LearnPanel" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Padding="16,14" Margin="0,14,0,0"
                                    Visibility="Collapsed">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Überspringen" Click="LearnSkip_Click" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Abbrechen" Click="LearnCancel_Click"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="LearnStep" Style="{StaticResource Hint}" Foreground="#C9BEFF"/>
                                        <TextBlock x:Name="LearnText" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <UniformGrid x:Name="AssignGrid" Columns="3" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Drehregler" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,8" Text="Lege fest, was Drehen und Drücken der drei Regler bewirkt."/>
                            <Grid x:Name="KnobConfigGrid"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Seite: Audio ===== -->
            <ScrollViewer x:Name="PageAudio" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Audio &amp; Discord" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,18" FontSize="13.5"
                               Text="Wähle, wo du die Sounds hörst – und schicke sie zusammen mit deiner Stimme in Discord, Spiele und Voice-Chats."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F6;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Was du selbst hörst" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Ausgabegerät (Kopfhörer / Lautsprecher)" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="MonitorBox" SelectionChanged="AudioBox_SelectionChanged"/>
                            <Grid>
                                <TextBlock Text="Lautstärke beim Mithören" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="MonitorVolText" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="MonitorVol" Minimum="0" Maximum="1" ValueChanged="MonitorVol_ValueChanged"/>
                            <Border x:Name="MonitorMeterTrack" Style="{StaticResource MeterTrack}" Margin="0,6,0,0">
                                <Border x:Name="MonitorMeterFill" Style="{StaticResource MeterFill}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="MixEnabledBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Aktiv" Margin="0"
                                          Checked="MixEnabled_Changed" Unchecked="MixEnabled_Changed"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Discord- &amp; Voice-Chat-Modus" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Windows kann einen Lautsprecher nicht als Mikrofon benutzen. Deshalb mischt Krach dein echtes Mikrofon und die Sounds in ein virtuelles Audiokabel. In Discord wählst du dann das Kabel als Mikrofon – deine Freunde hören Stimme und Sounds."/>

                            <Border x:Name="CableBorder" CornerRadius="12" Padding="14,12" Margin="0,14,0,0" Background="{StaticResource Card2Brush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="CableSetupButton" Style="{StaticResource AccentButton}" Content="Automatisch einrichten"
                                                Click="CableSetup_Click" Margin="8,0,0,0"/>
                                        <Button x:Name="CableDownloadButton" Content="VB-CABLE herunterladen (gratis)" Click="CableDownload_Click" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CableText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"/>
                                </DockPanel>
                            </Border>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Dein echtes Mikrofon" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="MicBox" SelectionChanged="AudioBox_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Virtuelles Kabel (Ausgang für Voice-Chat)" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="MixBox" SelectionChanged="AudioBox_SelectionChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <TextBlock Text="Mikrofon-Lautstärke" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="MicVolText" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="MicVol" Minimum="0" Maximum="2" ValueChanged="MicVol_ValueChanged"/>
                            <TextBlock Text="Mikrofon-Pegel" Style="{StaticResource Label}" Margin="0,10,0,6"/>
                            <Border x:Name="MicMeterTrack" Style="{StaticResource MeterTrack}">
                                <Border x:Name="MicMeterFill" Style="{StaticResource MeterFill}"/>
                            </Border>
                            <TextBlock Text="Was die anderen hören (Mix)" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                            <Border x:Name="ChatMeterTrack" Style="{StaticResource MeterTrack}">
                                <Border x:Name="ChatMeterFill" Style="{StaticResource MeterFill}"/>
                            </Border>

                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="MicMuteBox" Style="{StaticResource Switch}" Content="Mikrofon stummschalten" Margin="0,10,28,0"
                                          Checked="MicMute_Changed" Unchecked="MicMute_Changed"/>
                                <CheckBox x:Name="MicIntoMixBox" Style="{StaticResource Switch}" Content="Mikrofon mitmischen" Margin="0,10,28,0"
                                          Checked="MixOption_Changed" Unchecked="MixOption_Changed"/>
                                <CheckBox x:Name="SoundsIntoMixBox" Style="{StaticResource Switch}" Content="Sounds in den Voice-Chat schicken" Margin="0,10,0,0"
                                          Checked="MixOption_Changed" Unchecked="MixOption_Changed"/>
                            </WrapPanel>

                            <Border CornerRadius="12" Padding="16,14" Margin="0,18,0,0" Background="{StaticResource AccentSoftBrush}">
                                <StackPanel>
                                    <TextBlock Text="So stellst du Discord ein" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DiscordGuide" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13" LineHeight="21" Foreground="#D9D2FF"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="FxOnBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Aktiv" Margin="0"
                                          Checked="FxOn_Changed" Unchecked="FxOn_Changed"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Live-Stimmeffekt" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Verändert deine Stimme live, während du redest – im Voice-Chat-Modus hören die anderen den Effekt. Umschalten geht auch per Drehregler (unter „Makropad“ einstellen). Testen kannst du ihn mit dem Mikrofontest in Discord."/>
                            <WrapPanel x:Name="FxPanel" Margin="0,14,0,0"/>
                            <Border CornerRadius="12" Padding="14,12" Margin="0,14,0,0" Background="{StaticResource Card2Brush}">
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SubBrush}"
                                           Text="Echte KI-Stimme (z. B. RVC über den kostenlosen w-okada Voice Changer): Stelle dort dein Mikrofon als Eingang und ein ZWEITES virtuelles Kabel als Ausgang ein (z. B. VB-CABLE A+B). Wähle dann hier oben bei „Dein echtes Mikrofon“ den Ausgang dieses zweiten Kabels. Krach mischt die geklonte Stimme und deine Sounds zusammen für Discord. Lass den Effekt hier dann aus."/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AudioProblemsBorder" Style="{StaticResource Card}" Background="{StaticResource WarnSoftBrush}" BorderBrush="#6B5620"
                            Visibility="Collapsed">
                        <TextBlock x:Name="AudioProblems" TextWrapping="Wrap" Foreground="#FFE3A3"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Seite: Einstellungen ===== -->
            <ScrollViewer x:Name="PageSettings" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Einstellungen" Style="{StaticResource H1}" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Start &amp; Hintergrund" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="AutostartBox" Style="{StaticResource Switch}" Content="Mit Windows starten" Margin="0,14,0,0"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="AutostartTrayBox" Style="{StaticResource Switch}" Content="Beim Autostart nur im Infobereich starten (ohne Fenster)"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="CloseTrayBox" Style="{StaticResource Switch}" Content="Beim Schließen im Hintergrund weiterlaufen"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Wiedergabe" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="SingleBox" Style="{StaticResource Switch}" Content="Nur einen Sound gleichzeitig erlauben" Margin="0,14,0,0"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Start/Stopp, Neustart, Überlagern und Endlosschleife stellst du pro Sound in der Bibliothek ein."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sicherheit" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" FontSize="13"
                                       Text="Krach greift nur auf das ausgewählte Makropad zu. Deine normale Tastatur läuft nie durch das Programm. Mit dem Notaus (Knopf links oder Strg + Alt + F12) werden sofort alle gerätespezifischen Eingabe-Hooks abgeschaltet. Beim Beenden oder bei einem Absturz gibt Windows das Makropad automatisch wieder frei."/>
                            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Daten" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="DataPathText" Style="{StaticResource Hint}" Margin="0,8,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Datenordner öffnen" Click="OpenDataFolder_Click"/>
                                <Button Content="Protokoll öffnen" Margin="8,0,0,0" Click="OpenLog_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Über Krach" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" Margin="0,8,0,0" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
